version 10.3.1

group ElmishPaint
    source https://api.nuget.org/v3/index.json
    framework: net10.0
    storage: none

    nuget FSharp.Core ~> 10
    nuget Feliz ~> 3
    nuget Feliz.UseElmish ~> 4
    nuget Elmish ~> 5
    nuget Fable.Elmish ~> 5
    nuget Fable.Elmish.React ~> 5
    nuget Fable.Elmish.HMR ~> 8
    nuget Fable.Browser.Dom ~> 2
    nuget Fable.Browser.Event ~> 1
    nuget Fable.Promise ~> 3
    nuget Vitest ~> 1
    nuget Vitest.JestDom ~> 1
    nuget Vitest.ReactTestingLibrary ~> 1
    nuget Vitest.UserEvent ~> 1
